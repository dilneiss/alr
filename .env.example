DATABASE_URL=sqlite://alr_state.db
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CONFIDENCE_THRESHOLD=0.85
NOVELTY_THRESHOLD=0.60
MAX_ACTIONS_PER_SECOND=20
SNAKE_WIDTH=20
SNAKE_HEIGHT=20
SNAKE_SPEED=100
SNAKE_GRID_SIZE=20
SNAKE_CAPTURE_REGION=0,0,600,600
RUST_LOG=info

# Configurações do Copiloto de Call de Vendas ALR
PORT=3001

# URL da API do ALR (System 1 Canônico ou endpoint remoto TypeSafe JEV)
ALR_API_URL=http://localhost:3000/v1/systemone

# Chave de autenticação da nossa API (se requerida; mantida segura no backend, nunca exposta ao navegador)
ALR_API_KEY=
