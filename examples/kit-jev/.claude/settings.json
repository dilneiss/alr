{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node kit/jev-kit.mjs sessao --hook", "timeout": 30 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node kit/jev-kit.mjs *)",
      "Bash(node kit/jev-kit.mjs)",
      "Read(catalogo/**)",
      "Read(docs/**)",
      "Read(apps/**)"
    ],
    "deny": [
      "Read(segredos/**)",
      "Read(.kit/build/**)"
    ]
  }
}
